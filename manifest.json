{
  "manifest_version": 3,
  "name": "Infinity Snap for Google Meet",
  "short_name": "Infinity Snap",
  "version": "1.0.0",
  "description": "Snap your fingers in Google Meet and turn to dust, Endgame-style. You come back after 20 seconds.",
  "minimum_chrome_version": "111",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Infinity Snap",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  },
  "permissions": ["storage"],
  "host_permissions": ["https://meet.google.com/*"],
  "content_scripts": [
    {
      "matches": ["https://meet.google.com/*"],
      "js": [
        "src/page/fx-engine.js",
        "src/page/snap-detector.js",
        "src/page/hook.js"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": false
    },
    {
      "matches": ["https://meet.google.com/*"],
      "js": ["src/bridge.js"],
      "run_at": "document_start",
      "all_frames": false
    }
  ]
}
